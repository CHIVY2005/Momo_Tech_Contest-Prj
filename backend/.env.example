# VeriShield AI v2.0 — Backend Environment Template
# Copy this file to backend/.env and fill in your API keys locally / on VPS.
# NEVER commit backend/.env or any real API key to Git!

# --- LLM Provider & Endpoint Configuration ---
# Supported LLM_PROVIDER values:
#   - openai_compatible : Use OpenAI-compatible endpoint such as CLIProxyAPI (CPA)
#   - google_genai      : Use official Google AI Studio Gemini API directly
#   - auto              : Automatically uses openai_compatible when GEMINI_BASE_URL is set, else google_genai
LLM_PROVIDER=openai_compatible
GEMINI_BASE_URL=https://cpa.joiboi.app/v1
GEMINI_MODEL=gemini-2.5-flash

# Primary & optional backup API keys (works with both CPA Bearer tokens and Google AI Studio keys)
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=

# Timeout (seconds) per request attempt & max retries per key on 429 / 5xx / network timeout
LLM_TIMEOUT_SEC=18
LLM_MAX_RETRIES=2

# --- Telegram 1-Tap Bot (Optional until VPS deploy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Fraud Ops (/radar) & Multi-Judge Demo Isolation ---
ANALYST_PIN=2026
BLOCK_RULE_TTL_MINUTES=30

# --- Storage & Forensics Runtime ---
MODEL_DIR=app/data/models
SQLITE_PATH=verishield.db
MAX_UPLOAD_BYTES=10485760

ENABLE_LIVE_NETWORK_CHECKS=true
ENABLE_PLAYWRIGHT_SANDBOX=true
ENABLE_LOCAL_OCR=true
ENABLE_LOCAL_STT=true

RATE_LIMIT_PER_MINUTE=45
CORS_ORIGINS=["http://localhost:3000","https://verishield.joiboi.app"]
