http://{$DOMAIN:verishield.joiboi.app} {
    header -Server
    redir https://{host}{uri} 308
}

{$DOMAIN:verishield.joiboi.app} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }

    @app_html {
        not path /api/*
    }
    header @app_html {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }

    @encoded_path_sep expression `{http.request.orig_uri}.split('?')[0].lowerAscii().contains('%2f') || {http.request.orig_uri}.split('?')[0].lowerAscii().contains('%5c') || {http.request.orig_uri}.split('?')[0].contains('\\')`
    handle @encoded_path_sep {
        respond "Bad Request" 400
    }

    handle /api/* {
        request_body {
            max_size 22MB
        }
        reverse_proxy backend:8000 {
            flush_interval -1
            header_up X-Forwarded-For {remote_host}
        }
    }

    handle {
        request_body {
            max_size 1MB
        }
        reverse_proxy frontend:3000
    }
}
