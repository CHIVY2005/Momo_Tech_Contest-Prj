# Production VPS environment template (Copy to deploy/.env.prod on VPS — NEVER commit real secrets)
DOMAIN=verishield.joiboi.app

LLM_PROVIDER=openai_compatible
GEMINI_BASE_URL=https://cpa.joiboi.app/v1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
LLM_TIMEOUT_SEC=35
LLM_MAX_RETRIES=2

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Set a strong secret PIN in real production, or set ANALYST_PIN=2026 on a contest judge-demo instance
ANALYST_PIN=CHANGE_ME_STRONG_ANALYST_PIN
BLOCK_RULE_TTL_MINUTES=30
CORS_ORIGINS=["https://verishield.joiboi.app"]
