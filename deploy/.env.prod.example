# Production VPS environment template (Copy to deploy/.env.prod on VPS — NEVER commit real secrets)
DOMAIN=verishield.joiboi.app

LLM_PROVIDER=openai_compatible
GEMINI_BASE_URL=https://cpa.joiboi.app/v1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_BACKUP_API_KEY=
LLM_TIMEOUT_SEC=35
LLM_MAX_RETRIES=2

TELEGRAM_BOT_TOKEN=
# Mandatory when TELEGRAM_BOT_TOKEN is set (>= 24 chars, high-entropy, independent of ANALYST_PIN)
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_URL=
PUBLIC_BASE_URL=https://verishield.joiboi.app

# Default production posture requires a strong >= 8 char secret ANALYST_PIN.
# (Only set APP_ENV=demo + ANALYST_PIN=2026 on an isolated contest judge-demo deployment.)
APP_ENV=production
ANALYST_PIN=
# Mandatory in production: dedicated HMAC-SHA256 secret for IOC matching (>= 16 chars, independent of ANALYST_PIN)
IOC_HMAC_SECRET=
# Mandatory in production: dedicated HMAC-SHA256 secret for X-Case-Access-Token signing (>= 32 chars, independent of IOC_HMAC_SECRET and ANALYST_PIN)
CASE_TOKEN_SECRET=

# Network & reverse-proxy trust boundary (keep UVICORN_FORWARDED_ALLOW_IPS scoped to proxy_backend)
PROXY_BACKEND_SUBNET=172.28.0.0/24
UVICORN_FORWARDED_ALLOW_IPS=172.28.0.0/24

ONNX_INTRA_THREADS=2
UVICORN_WORKERS=1
PLAYWRIGHT_MAX_CONCURRENCY=1
BLOCK_RULE_TTL_MINUTES=30
CORS_ORIGINS=["https://verishield.joiboi.app"]
